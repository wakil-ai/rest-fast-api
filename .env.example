APP_NAME=WakilAIChatbot
VERSION=5.0.0
DEBUG=false
HOST_URL=https://backend.wakil.ai

# Authentication & security
API_KEY_NAME=x-api-key
API_KEY=your-api-key-here
SUPER_ADMIN_KEY_NAME=x-super-admin-key
SUPER_ADMIN_API_KEY=your-super-admin-key
DOCS_USER=admin
DOCS_PASSWORD=secure-password
AUTH_SECRET_KEY=your-auth-secret-key
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=wakilai-frontend
JWT_AUDIENCE=wakilai-rest-api
AUTH_USER_STATUS_CACHE_TTL_SECONDS=60

# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=wakilai
COLLECTION_NAME=itemdocs
CRIMINAL_CASES_MONGODB_DATABASE=criminal
USERS_COLLECTION=users
SESSIONS_COLLECTION=sessions
MESSAGES_COLLECTION=messages
FILES_COLLECTION=files
PROJECTS_COLLECTION=projects
PROJECT_MEMBERS_COLLECTION=project_members
PROJECT_INVITES_COLLECTION=project_invites
TRANSACTION_COLLECTION=transactions
SUBSCRIPTIONS_COLLECTION=subscriptions
RATE_LIMIT_COLLECTION=creditusage

# Internal LLM service (rest-api -> rest-api-llm)
LLM_SERVICE_URL=http://rest-api-ai:8000
LLM_SERVICE_INTERNAL_TOKEN=change-me-in-production
LLM_SERVICE_INTERNAL_HEADER=x-internal-token
LLM_SERVICE_TIMEOUT_SECONDS=600
LLM_SERVICE_EMBEDDING_MODEL_NAME=rest-api-ai

# File processing
DOCUMENT_PROCESSING_POLL_TIMEOUT_SECONDS=900

# Chat/file behavior owned by the public backend
STREAM=true
STREAM_KEEPALIVE_INTERVAL_SECONDS=15
STREAM_SSE_MAX_RESPONSE_CHARS=200
TOP_K=10
CHAT_HISTORY_LIMIT=5
MAX_QUERY_LENGTH=5000
FILE_CONTENT_TOKEN_LIMIT=50000
FILE_SEARCH_TOP_K=3
PROJECT_FILES_INDEX_NAME=project_files
CONTRACT_ATTACHMENT_MIN_SIMILARITY=0.6

# Google auth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# Telegram authentication
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_LOGIN=your-bot-username
TELEGRAM_SESSION_TIMEOUT=259200

# Twilio Verify (OTP)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid
OTP_SEND_LIMIT_PER_PHONE=3
OTP_SEND_WINDOW_SECONDS=3600
OTP_VERIFY_LIMIT_PER_PHONE=10
OTP_VERIFY_WINDOW_SECONDS=3600

# Google Cloud Storage
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_PROJECT_ID=your-gcs-project-id
GCS_CLIENT_EMAIL=service-account@your-gcs-project-id.iam.gserviceaccount.com
GCS_PRIVATE_KEY_ID=your-private-key-id
# GitHub Actions secrets may store this with literal \\n characters.
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
GCS_CLIENT_ID=your-service-account-client-id
# Optional local fallback; prefer the variables above in CI/deployments.
GCS_CREDENTIALS_PATH=

# Redis cache/session helpers
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_EXPIRATION_SECONDS=259200

# Payme
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
PAYME_PAYMENT_LINK_BASE=https://checkout.paycom.uz/
PAYME_FISCAL_COLLECTION=payme_fiscal
PAYME_SUBSCRIPTION_BASIC_DAILY_PRICE_SUM=15000
PAYME_SUBSCRIPTION_STANDARD_DAILY_PRICE_SUM=30000
PAYME_SUBSCRIPTION_PREMIUM_DAILY_PRICE_SUM=50000
PAYME_SUBSCRIPTION_STANDARD_MONTHLY_PRICE_SUM=350000
PAYME_SUBSCRIPTION_STANDARD_YEARLY_PRICE_SUM=3500000
PAYME_SUBSCRIPTION_PRO_MONTHLY_PRICE_SUM=1000000
PAYME_SUBSCRIPTION_PRO_YEARLY_PRICE_SUM=10000000
PAYME_SUBSCRIPTION_TEST_MONTHLY_PRICE_SUM=10000
PAYME_SUBSCRIPTION_TEST_YEARLY_PRICE_SUM=100000

# Click
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
CLICK_PAYMENT_LINK_BASE=https://my.click.uz/services/pay

# Uzum
UZUM_USERNAME=
UZUM_PASSWORD=
UZUM_SERVICE_ID=
UZUM_TRANSACTIONS_COLLECTION=uzum_transactions

# Apple App Store (StoreKit 2 IAP)
APPSTORE_BUNDLE_ID=ai.humblebee.wakil
# Xcode Debug build bundle id, trusted only when DEBUG=true (default: <APPSTORE_BUNDLE_ID>-debug).
APPSTORE_DEBUG_BUNDLE_ID=ai.humblebee.wakil-debug
# Numeric App Store app id (App Store Connect → App → App Information → "Apple ID").
# REQUIRED before production JWS verification works; leave blank for sandbox-only.
APPSTORE_APP_APPLE_ID=
# OCSP revocation checks during Apple cert-chain verification (needs outbound net to Apple).
APPSTORE_ENABLE_ONLINE_CHECKS=true
# Directory of Apple root CA .cer files. Defaults to src/resources/certs/apple.
APPSTORE_ROOT_CERTS_DIR=
APPSTORE_TRANSACTIONS_COLLECTION=appstore_transactions

# B2B / DT
DT_API_KEY_NAME=x-dt-team-api-key
DT_API_KEY=
DT_TEAM_DISCLAIMER="\n\n> *DIQQAT! Ushbu protsessual hujjat loyihasi “WakilAI” sun’iy intellekt tizimi yordamida shakllantirildi. Hujjatni sudga taqdim etishdan avval malakali va professional advokat bilan maslahatlashish tavsiya etiladi.*"

# Bitrix24 CRM
BITRIX24_WEBHOOK_URL=
BITRIX24_LEAD_TITLE=Wakil platform
BITRIX24_LEAD_SOURCE_ID=
BITRIX24_LEAD_SOURCE_DESCRIPTION=Wakil platforma
BITRIX24_LEAD_ASSIGNED_BY_ID=
BITRIX24_TIMEOUT_SECONDS=10
