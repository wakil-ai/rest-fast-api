APP_NAME=WakilAIChatbot
VERSION=5.0.0
DEBUG=false

# Authentication & Security
API_KEY_NAME=x-api-key
API_KEY=your-api-key-here
DOCS_USER=admin
DOCS_PASSWORD=secure-password

# Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=wakilai
COLLECTION_NAME=itemdocs
USERS_COLLECTION=users
SESSIONS_COLLECTION=sessions
MESSAGES_COLLECTION=messages
FEEDBACK_COLLECTION=feedbacks

# Vector Database (choose one)
VECTOR_DB_TYPE=milvus  # or pinecone

# Milvus Configuration
MILVUS_URI=http://localhost:19530
MILVUS_CACHE_DIR=/path/to/your/milvus-cache
MILVUS_MAIN_NAME=lexuz
MILVUS_USER=optional-username
MILVUS_PASSWORD=optional-password
MILVUS_TOKEN=optional-token

# Or Pinecone Configuration
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=your-index
NAMESPACE_NAME=lexuz

# Memory Management
MEM0_API_KEY=your-mem0-api-key
MEM0_PROJECT_ID=your-mem0-project-id
MEM0_ORG_ID=your-mem0-org-id

# LLM Configuration
LLM_PROVIDER=novita  # novita, local

# Novita AI
NOVITA_API_KEY=your-novita-key
NOVITA_MODEL=google/gemma-3-27b-it
NOVITA_EMBEDDING_BASE_URL=https://api.novita.ai/openai
NOVITA_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# OpenAI Configuration
OPENAI_API_KEY=your-openai-key
# Final-answer chat model. Use an OpenAI model (e.g. gpt-5.2) for OpenAI generation,
# or a gemini-* model name to route generation through Google Gemini instead.
DEFAULT_CHAT_MODEL=gpt-5.2
DEFAULT_LITE_MODEL=gpt-4.1-mini
GPT_COMPLETION_MODEL=gpt-5.2
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Gemini Configuration
GEMINI_API_KEY=your-gemini-key
DEFAULT_CHAT_MODEL=gemini-3.1-pro-preview
GEMINI_LANGCHAIN_THINKING_LEVEL=high
GEMINI_EXPLICIT_CACHE_ENABLED=false
GEMINI_EXPLICIT_CACHE_TTL=3600s
GEMINI_EXPLICIT_CACHE_MIN_TOKENS=4096
GEMINI_EXPLICIT_CACHE_MAX_LOCAL_ENTRIES=256

# Local VLLM Configuration
LOCAL_VLLM_BASE_URL=http://localhost:8000
LOCAL_VLLM_MODEL=gpt-oss-120b
LOCAL_VLLM_API_KEY=sk-no-key-required

# DeepInfra Configuration
DEEPINFRA_API_KEY=your-deepinfra-key
DEEPINFRA_EMBEDDING_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B

# Silicon FLow
SILICONFLOW_API_KEY=sk-your-silicon-flow-api

# Embedding Configuration
EMBEDDING_MODEL=qwen  # qwen, openai, novita_qwen, deepinfra

# Qwen VLLM Embedding (if using local)
QWEN_EMBEDDING_URL=http://localhost:8001
QWEN_EMBEDDING_MODEL=qwen-embedding

# Speech-to-Text Configuration
SPEECH_TO_TEXT_PROVIDER=azure  # google, azure

# Azure Speech Services
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=your-azure-region

# Telegram Authentication
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_LOGIN=your-bot-username
TELEGRAM_SESSION_TIMEOUT=259200  # 3 days in seconds

# Performance & Behavior Settings
STREAM=true
TOP_K=10
ALPHA=0.8
TEMPERATURE=0.1
CHAT_HISTORY_LIMIT=5
OUTPUT_MAX_TOKENS=8192
FILE_CONTENT_TOKEN_LIMIT=5000

# Milvus file search for oversized uploaded files
FILE_SEARCH_TOP_K=3

# Tavily API Key
TAVILY_API_KEY=your-tavily-api-key

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback
AUTH_SECRET_KEY=your_auth_secret_key

# Twilio Verify (OTP)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid
# Optional rate-limit overrides (defaults: 3 sends / 10 verifies per phone per hour)
# OTP_SEND_LIMIT_PER_PHONE=3
# OTP_SEND_WINDOW_SECONDS=3600
# OTP_VERIFY_LIMIT_PER_PHONE=10
# OTP_VERIFY_WINDOW_SECONDS=3600

GCS_CREDENTIALS_PATH=src/security/gcs_creds.json
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_PROJECT_ID=your-gcs-project-id

# Payme
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
PAYME_PAYMENT_LINK_BASE=https://checkout.paycom.uz/
PAYME_FISCAL_COLLECTION=payme_fiscal

# Payme subscription prices (SUM)
PAYME_SUBSCRIPTION_BASIC_DAILY_PRICE_SUM=15000
PAYME_SUBSCRIPTION_STANDARD_DAILY_PRICE_SUM=30000
PAYME_SUBSCRIPTION_PREMIUM_DAILY_PRICE_SUM=50000
PAYME_SUBSCRIPTION_STANDARD_MONTHLY_PRICE_SUM=350000
PAYME_SUBSCRIPTION_STANDARD_YEARLY_PRICE_SUM=3500000
PAYME_SUBSCRIPTION_PRO_MONTHLY_PRICE_SUM=1000000
PAYME_SUBSCRIPTION_PRO_YEARLY_PRICE_SUM=10000000

# Payme test plan prices (SUM)
PAYME_SUBSCRIPTION_TEST_MONTHLY_PRICE_SUM=10000
PAYME_SUBSCRIPTION_TEST_YEARLY_PRICE_SUM=100000

# Uzum Merchant API (webhook-only — we pick username/password/serviceId ourselves
# and share them with Uzum so they can test via Postman).
UZUM_USERNAME=
UZUM_PASSWORD=
UZUM_SERVICE_ID=
UZUM_TRANSACTIONS_COLLECTION=uzum_transactions


DT_TEAM_DISCLAIMER="\n\n> *DIQQAT! Ushbu protsessual hujjat loyihasi “WakilAI” sun’iy intellekt tizimi yordamida shakllantirildi. Hujjatni sudga taqdim etishdan avval malakali va professional advokat bilan maslahatlashish tavsiya etiladi.*"

# Langfuse (LangChain tracing) — https://langfuse.com/docs/integrations/langchain
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Self-hosted or cloud base URL (LANGFUSE_HOST is an alias)
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_HOST=http://localhost:3000
